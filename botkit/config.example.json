{
  "guild_id": "YOUR_SERVER_ID",
  "features": ["scheduler", "mcstatus_alert", "modflag", "purge_mine", "translate", "verify", "tickets", "welcome", "server_logs", "rolemenu", "admin", "pricealerts"],
  "message_content_intent": true,
  "members_intent": true,
  "scheduler": {
    "timezone": "America/New_York",
    "posts": [
      {"channel_id": "CHANNEL_ID", "days": ["mon"], "time": "09:00", "message": "📅 Weekly check-in: what are you working on this week?"}
    ]
  },
  "mcstatus": {"address": "play.example.com", "channel_id": "CHANNEL_ID", "interval_seconds": 60},
  "modflag": {"mod_channel_id": "MOD_CHANNEL_ID"},
  "translate": {
    "backend": "libretranslate",
    "libretranslate_url": "http://127.0.0.1:5000/translate",
    "default_target": "en",
    "max_chars": 1500,
    "channels": {"CHANNEL_ID": "en"}
  },
  "verify": {
    "role_id": "VERIFIED_ROLE_ID",
    "log_channel_id": "MOD_CHANNEL_ID",
    "captcha": true,
    "title": "Verification",
    "text": "Click **Verify** to get access to the server."
  },
  "tickets": {
    "staff_role_id": "STAFF_ROLE_ID",
    "mode": "thread",
    "channel_id": "CHANNEL_ID",
    "title": "Support",
    "text": "Click **Open a ticket** or use `/ticket` to talk privately with staff."
  },
  "welcome": {
    "channel_id": "CHANNEL_ID",
    "message": "Welcome {member} to **{server}**! You are member #{count}."
  },
  "server_logs": {
    "channel_id": "LOG_CHANNEL_ID",
    "events": ["join", "leave", "delete", "edit", "roles"]
  },
  "rolemenu": {
    "style": "buttons",
    "title": "Roles",
    "text": "Pick the roles you want. Buttons toggle a role. A select menu keeps only the roles you select.",
    "roles": [
      {"role_id": "ROLE_ID", "label": "Announcements", "emoji": "📢"}
    ]
  },
  "admin": {
    "staff_role_id": "STAFF_ROLE_ID"
  },
  "pricealerts": {
    "channel_id": "CHANNEL_ID",
    "interval_minutes": 5,
    "market_hours_only": true,
    "delivery": "channel",
    "max_alerts_per_user": 10
  }
}
